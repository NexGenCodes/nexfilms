generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  MOVIES
  SERIES
}

enum VideoQualityType {
  Q240P
  Q480P
  Q720P
  Q1080P
}

enum PgRating {
  G
  PG
  PG_13
  R
  NC_17
  TV_Y
  TV_Y7
  TV_G
  TV_PG
  TV_14
  TV_MA
}

model VideoQuality {
  id        String           @id @default(cuid())
  episodeId String? // Optional for Episode relation
  movieId   String? // Optional for Movie relation
  quality   VideoQualityType
  url       String           @db.VarChar(2048)
  episode   Episode?         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  movie     Movie?           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  // Enforce exactly one of episodeId or movieId non-null in DB constraint

  @@unique([episodeId, quality], map: "unique_episode_quality")
  @@unique([movieId, quality], map: "unique_movie_quality")
  @@index([episodeId, quality])
  @@index([movieId, quality])
}

model Content {
  id          String      @id @default(cuid())
  title       String
  description String      @db.Text
  releaseDate DateTime
  director    String
  duration    Int         @db.SmallInt // Use Int for duration
  pgRating    PgRating 
  posterUrl   String
  type        ContentType
  isAnimation Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  backdropUrl String      @db.VarChar(2048)

  // Relations
  cast   Cast[]         @relation("ContentCast")
  genres GenreContent[] // Many-to-many relation with Genre
  movie  Movie? // One-to-one relation with Movie
  series Series? 

  @@index([title])
  @@index([description])
  @@index([type])
}

model Movie {
  id             String         @id @default(cuid())
  content        Content        @relation(fields: [id], references: [id], onDelete: Cascade)
  videoQualities VideoQuality[]
  rating         Float          @db.Real
  trailerUrl     String?        @db.VarChar(2048)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Series {
  id        String   @id
  content   Content  @relation(fields: [id], references: [id], onDelete: Cascade)
  seasons   Season[] // One-to-many relation with Season
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Season {
  id        String    @id @default(cuid())
  seriesId  String
  number    Int       @db.SmallInt
  title     String    @db.VarChar(255)
  posterUrl String    @db.VarChar(2048)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  series    Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes  Episode[]
}

model Episode {
  id             String         @id @default(cuid())
  number         Int            @db.SmallInt
  title          String         @db.VarChar(255)
  description    String         @db.Text
  duration       Int            @db.SmallInt
  posterUrl      String         @db.VarChar(2048)
  rating         Float          @db.Real // 0-5, enforced by DB constraint
  seasonId       String
  trailerUrl     String?        @db.VarChar(2048)
  season         Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  videoQualities VideoQuality[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contents GenreContent[] // Many-to-many relation with Content

  @@index([name])
}

model GenreContent {
  contentId String
  genreId   String

  // Relations
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([contentId, genreId])
}

model Cast {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contents Content[] @relation("ContentCast") // Many-to-many relation with Content
}
