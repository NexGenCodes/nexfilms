// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ContentType {
  MOVIES
  SERIES
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  role          UserRole  @default(USER)
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  watchlist Watchlist[]
}

model Movie {
  id          String      @id @default(cuid())
  title       String
  type        ContentType
  isAnimation Boolean
  posterUrl   String
  backdropUrl String
  year        String
  releaseDate DateTime
  rating      Float 
  genres      String[]
  description String
  duration    Int
  trailerUrl  String?
  videoUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  seasons     Season[]
  watchlist   Watchlist[]
}

model Season {
  id           String    @id @default(cuid())
  seasonNumber Int
  title        String
  posterUrl    String
  episodes     Episode[]
  Movie        Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId      String
  overview     String?
  releaseDate  DateTime
}

model Episode {
  id            String   @id @default(cuid())
  episodeNumber Int
  title         String
  description   String
  duration      Int
  thumbnailUrl  String
  videoUrl      String
  releaseDate   DateTime
  seasonId      String
  trailerUrl    String
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id      String   @id @default(cuid())
  userId  String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Movie   Movie    @relation(fields: [movieId], references: [id])
  movieId String

  @@unique([userId, movieId])
}
